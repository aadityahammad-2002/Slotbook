# Windows / existing PostgreSQL, no Docker. Set your actual password before starting.
# Never reuse the older Python project's database name (slotbook).
DATABASE_URL=postgresql://slotbook:REPLACE_WITH_REAL_PASSWORD@127.0.0.1:5432/slotbook_ts
TEST_DATABASE_URL=postgresql://slotbook:REPLACE_WITH_REAL_PASSWORD@127.0.0.1:5432/slotbook_ts_test
# Fails fast if DATABASE_URL accidentally selects the older Python app database.
EXPECTED_DATABASE_NAME=slotbook_ts
PORT=3000
COOKIE_SECURE=false
DEMO_EMAIL=demo@slotbook.local
DEMO_PASSWORD=DemoPass!2026
